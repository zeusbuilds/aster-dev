# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/android/build/
/pubspec_overrides.yaml
/ios/.spm.pods/

# Generated files
*.g.dart
*.freezed.dart
*.mocks.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/

# direnv environment
.direnv/

# Repository-local Ruby gems installed from Gemfile.lock.
/.bundle/

# Release-owned non-secret manifests and signing/export inputs. The reviewed
# schema and deliberately invalid example remain versioned under config/.
/config/*.local.json
/ios/ExportOptions*.local.plist

# App-owned local chain/index/consignment data and RPC credentials, not caches.
/.local/
