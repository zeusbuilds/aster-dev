<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/aster_splash_top</item>
        <item name="android:navigationBarColor">@color/aster_splash_dark</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/aster_surface</item>
        <item name="android:statusBarColor">@color/aster_surface</item>
        <item name="android:navigationBarColor">@color/aster_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
