<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Explicitly light parents keep native launch chrome identical in both
         system appearances without night variants masking newer API styles. -->
    <style name="AsterLaunchBase" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <!-- API 24-26 cannot draw dark navigation icons. -->
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AsterNormalBase" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/aster_surface</item>
        <item name="android:statusBarColor">@color/aster_surface</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- API-qualified chrome overrides are also inherited by modern launch
         themes, keeping system-bar compatibility separate from splash APIs. -->
    <style name="AsterLaunchChrome" parent="AsterLaunchBase" />
    <style name="AsterNormalChrome" parent="AsterNormalBase" />
    <style name="LaunchTheme" parent="AsterLaunchChrome" />
    <style name="NormalTheme" parent="AsterNormalChrome" />
</resources>
