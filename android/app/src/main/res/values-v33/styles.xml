<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="AsterLaunchChrome">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/aster_launch_opening</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <!-- Keep the matching icon on non-launcher cold starts too. -->
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>
