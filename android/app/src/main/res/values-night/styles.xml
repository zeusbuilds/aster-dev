<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- UTEXO is intentionally light-only; system dark mode must not change launch chrome. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/utexo_splash_top</item>
        <item name="android:navigationBarColor">@color/utexo_splash_dark</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/utexo_surface</item>
        <item name="android:statusBarColor">@color/utexo_surface</item>
        <item name="android:navigationBarColor">@color/utexo_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
